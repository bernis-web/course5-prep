{
  "metrics": {
    "label_transfer.macro_f1": "number in [0, 1]",
    "embedding.silhouette": "number in [-1, 1]",
    "embedding.ilisi": "number >= 1",
    "embedding.kbet_rejection_rate": "number in [0, 1]",
    "embedding.kbet_method": "string; final stage cannot use chi2_neighborhood_proxy"
  },
  "resource_usage": {
    "wall_time_seconds": "number >= 0",
