{
  "project": "course5_cross_species_integration",
  "status": "preflight_only",
  "prohibited_until_explicit_approval": [
    "create_cloud_instance",
    "start_cloud_task",
    "upload_user_data",
    "download_large_dataset",
    "install_packages_on_dcs"
  ],
  "phase_policy": {
    "source": "teacher reply recorded 2026-09-10",
    "pilot_species_count_range": [2, 3],
    "pilot_goal": "prove_the_integration_pipeline_runs_end_to_end",
    "later_relationship_coverage": ["near", "far", "mixed_categories"],
    "species_selection_status": "pending_readonly_dcs_inventory",
    "primary_modality": "scRNA",
    "spatial_policy": "out_of_primary_scope",
    "snRNA_policy": "small_followup_after_scRNA_conclusion"
  },
  "datasets": {
    "heart_near": {
      "source": "HEART",
      "species_count": 3,
      "cell_types": ["CM", "FB"],
      "labels": "paper_annotations",
      "role": "pilot_default_within_two_to_three_species",
      "species_selection": "pending_readonly_dcs_inventory"
    },
    "heart_mid": {
      "source": "HEART",
      "species_count": 8,
      "cell_types": ["CM", "FB"],
      "labels": "paper_annotations",
      "role": "optional_eight_species_scaling_tier",
      "species_selection": "pending_readonly_dcs_inventory"
    },
    "heart_relationship_matrix": {
      "source": "HEART",
      "species_count_policy": "selected_per_combination",
      "relationship_coverage": ["near", "far", "mixed_categories"],
      "cell_types": ["CM", "FB"],
      "labels": "paper_annotations",
      "role": "integration_effectiveness_after_pilot",
      "species_selection": "pending_readonly_dcs_inventory"
    },
    "heart_full": {
      "source": "HEART",
      "species_count": 16,
      "cell_types": ["CM", "FB"],
      "labels": "paper_annotations",
      "role": "optional_full_scale_after_relationship_matrix",
      "species_selection": "pending_readonly_dcs_inventory"
    },
    "lbspa_cross_phylum": {
      "source": "LBSPA",
      "species": ["lamprey", "mouse"],
      "modality": "snRNA_followup_after_scRNA",
      "activation_gate": "scRNA_benchmark_conclusion_recorded",
      "spatial_policy": "excluded_from_primary_benchmark",
      "ortholog_policy": "one_to_one_only",
      "role": "small_cross_phylum_followup"
    }
  },
  "methods": [
    {
      "name": "SATURN",
      "kind": "protein_embedding_plus_latent_integration",
      "required_checks": ["protein_embedding_model", "macrogenes", "hvg_count", "gpu_visibility"]
    },
    {
      "name": "SAMap",
      "kind": "cross_species_mapping",
      "required_checks": ["ortholog_table", "mapping_parameters", "species_pair_order"]
    },
    {
      "name": "scVI",
      "kind": "latent_variable_integration",
      "required_checks": ["scvi_tools_version", "latent_dim", "epochs", "early_stopping", "gpu_visibility"]
    }
  ],
  "fixed_controls": {
    "random_seeds": [7, 17, 27],
    "hvg_policy": "fit_each_training_split_only",
    "label_transfer": "leave_one_species_out",
    "neighbor_count": 15,
    "metrics": ["macro_f1", "kbet", "ilisi", "silhouette", "wall_time_seconds", "peak_memory_gb"],
    "kbet_note": "Use the official implementation for final results; the local smoke test only uses a chi-square proxy."
  },
  "stopping_rules": {
    "max_trial_minutes": 25,
    "max_peak_memory_gb": 75,
    "max_trial_cost_cny": 10,
    "stop_instance_after_run": true
  },
  "required_artifacts_per_run": [
    "input_manifest.tsv",
    "ortholog_manifest.json",
    "parameters.json",
    "package_versions.txt",
    "stdout_stderr.log",
    "metrics.json",
    "resource_usage.json",
    "failure_reason.txt"
  ]
}
